  $default: 48
}
pin: color.primary, color.on-primary, color.surface, color.surface.sidebar, color.surface.container, color.surface.container.high, color.text.primary, color.text.secondary, color.text.muted, color.outline, color.success, color.warning, color.error, color.stage.qualified, color.stage.discovery, color.stage.proposal, color.stage.negotiation

