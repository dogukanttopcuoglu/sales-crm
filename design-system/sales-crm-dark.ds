inherits: none
root: true
modes {
  theme: [dark]
  density: [compact]
}
primary: boldness(color(#FFDC35), transforms: none)
success: boldness(color(#79B49A), transforms: none)
warning: boldness(color(#CEB773), transforms: none)
danger: boldness(color(#D88F94), transforms: none)
info: boldness(color(#A9BBD9), transforms: none)
neutral: boldness(color(#777777), transforms: none)
color.surface: #161616
color.surface.sidebar: #171717
color.surface.container: #1C1C1C
color.surface.chart: #1D1D1D
color.surface.container.high: #202020
color.surface.deal: #222222
color.surface.input: #191919
color.surface.hover: #242424
color.surface.pressed: #262626
color.surface.selected: #292929
color.surface.table.heading: #202020
color.surface.table.selected: #25251F
color.on-surface: #DDDDDD
color.on-surface.selected: #EEEEEE
color.outline: #303030
color.outline.variant: #292929
color.outline.control: #393939
color.outline.selected: #414141
color.outline.divider: #2A2A2A
color.primary: #FFDC35
color.on-primary: #232015
color.primary.container: #342F23
color.text.primary: #DDDDDD
color.text.heading: #EEEEEE
color.text.secondary: #BBBBBB
color.text.muted: #888888
color.text.caption: #777777
color.text.disabled: #515151
color.text.link: #B8B8B8
color.icon: #9B9B9B
color.icon.muted: #777777
color.icon.selected: #CCCCCC
color.success: #79B49A
color.success.container: #26362E
color.warning: #CEB773
color.warning.container: #342F23
color.error: #D88F94
color.error.container: #34262A
color.info: #A9BBD9
color.info.container: #26303E
color.status.commit: #6AB79C
color.status.commit.container: #1C392B
color.status.bestcase: #B9A8DF
color.status.bestcase.container: #2F263F
color.chart.track: #303030
color.chart.forecast: #D5BD57
color.stage.qualified: #868686
color.stage.discovery: #A9BBD9
color.stage.proposal: #B9A8DF
color.stage.negotiation: #63B398
color.region.northamerica: #FFDC35
color.region.emea: #ED4389
color.region.apac: #A269ED
color.timeline: #FFFFFF
color.timeline.selected: color.primary
color.shadow: #000000
spacing: tshirt(number([
  4,
  8,
  12,
  16,
  20,
  24,
  32,
  48,
  64
]), min: { none: 0 }, transforms: none)
spacing.panel.top: 18
spacing.panel.side: 20
spacing.page.inset: 20
spacing.section.gap: 20
spacing.sidebar.heading: 8
spacing.link.icon: 7
spacing.metric.label.top: 8
spacing.metric.value.top: 27
spacing.metric.caption.top: 39
radius: tshirt(number([
  2,
  5,
  7,
  9,
  12,
  16,
  24
]), min: { none: 0 }, max: { full: 9999 }, transforms: none)
radius.control: 7
radius.metric: 7
radius.panel: 9
radius.badge: 12
radius.filter: 24
stroke.width: boldness(number([
  0.5,
  0.75,
  1,
  1.25,
  1.5,
  2,
  2.5,
  3,
  4
]), min: { none: 0 }, transforms: none)
stroke.width.control: 1
visibility: boldness(number([
  0.05,
  0.10,
  0.20,
  0.40,
  0.50,
  0.60,
  0.80,
  0.90,
  0.95
]), min: { invisible: 0 }, max: { opaque: 1 }, transforms: none)
font.family: Inter
font.family.sans: font.family
font.size: tshirt(number([
  10,
  11,
  12,
  13,
  14,
  16,
  20,
  23,
  28,
  32
]), transforms: none)
font.size.caption: 10
font.size.label: 11
font.size.link: 12
font.size.table: 13
font.size.control: 14
font.size.section: 16
font.size.page: 20
font.size.metric: 23
font.size.target: 28
font.weight: boldness(number([
  100,
  200,
  300,
  400,
  500,
  600,
  700,
  800,
  900
]), transforms: none)
font.weight.regular: 400
font.weight.medium: 500
font.weight.semibold: 600
font.lineHeight: looseness(number([
  1,
  1.18,
  1.2,
  1.21,
  1.23,
  1.25
]), transforms: none)
font.letterSpacing: looseness(number([
  -0.05,
  -0.025,
  -0.0125,
  0,
  0.025,
  0.1
]), transforms: none)
typography.page: { fontFamily: font.family, fontSize: font.size.page, fontWeight: font.weight.medium, lineHeight: 1.2 }
typography.section: { fontFamily: font.family, fontSize: font.size.section, fontWeight: font.weight.medium, lineHeight: 1.25 }
typography.body: { fontFamily: font.family, fontSize: font.size.control, fontWeight: font.weight.regular, lineHeight: 1.21 }
typography.table: { fontFamily: font.family, fontSize: font.size.table, fontWeight: font.weight.regular, lineHeight: 1.23 }
typography.table.strong: { fontFamily: font.family, fontSize: font.size.table, fontWeight: font.weight.medium, lineHeight: 1.23 }
typography.label: { fontFamily: font.family, fontSize: font.size.label, fontWeight: font.weight.regular, lineHeight: 1.18 }
typography.caption: { fontFamily: font.family, fontSize: font.size.caption, fontWeight: font.weight.regular, lineHeight: 1.2 }
typography.link: { fontFamily: font.family, fontSize: font.size.link, fontWeight: font.weight.medium, lineHeight: 1.25 }
typography.button: { fontFamily: font.family, fontSize: font.size.control, fontWeight: font.weight.semibold, lineHeight: 1.21 }
typography.badge: { fontFamily: font.family, fontSize: font.size.label, fontWeight: font.weight.regular, lineHeight: 1.18 }
typography.metric: { fontFamily: font.family, fontSize: font.size.metric, fontWeight: font.weight.medium, lineHeight: 1.22 }
typography.target: { fontFamily: font.family, fontSize: font.size.target, fontWeight: font.weight.medium, lineHeight: 1.21 }
card.metric: {
  fills: [color.surface.container.high]
  strokes: []
  effects: []
  radius: radius.metric
}
card.panel: {
  fills: [color.surface.container]
  radius: radius.panel
}
card.deal: {
  fills: [color.surface.deal]
  radius: radius.control
}
button.primary: {
  fills: [color.primary]
  radius: radius.control
}
button.secondary: {
  fills: [color.surface.container.high]
  radius: radius.control
}
input.search: {
  fills: [color.surface.input]
  radius: radius.control
}
input.filter: {
  fills: [color.surface.container.high]
  radius: radius.filter
}
navigation.selected: {
  fills: [color.surface.selected]
  radius: radius.panel
}
badge.success: {
  fills: [color.success.container]
  radius: radius.badge
}
badge.warning: {
  fills: [color.warning.container]
  radius: radius.badge
}
badge.error: {
  fills: [color.error.container]
  radius: radius.badge
}
badge.commit: {
  fills: [color.status.commit.container]
  radius: radius.badge
}
badge.bestcase: {
  fills: [color.status.bestcase.container]
  radius: radius.badge
}
avatar.photo: { radius: radius.full }
progress.track: {
  fills: [color.chart.track]
  radius: radius.full
}
